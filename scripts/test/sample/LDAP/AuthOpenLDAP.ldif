# the toplevel otobotesting domain already exists

# Example structure based on a large restaurant

# create the wirtshaus domain, including a random id
dn: dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
objectclass: domain
dc: wirtshaus_[[RANDOM_ID]]
description: a restaurant is used as an example

# Three organisational units: kitchen, dining hall, and café sans souci
# Each organizationalUnit has the group otoboallow.
#
# The dining hall also has the group test_sync_group_2, test_sync_group_3A,
# test_sync_group_3B, test_sync_group_3C, and test_sync_group_3D.
# The test_sync_group_3[ABCD] are nested by the uniquemember being
# the distinguished name of the subgroup.

dn: ou=kitchen,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: organizationalUnit
ou: kitchen

dn: cn=otoboallow,ou=kitchen,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfNames
cn: otoboallow
member: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: organizationalUnit
ou: dining hall

dn: cn=otoboallow,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfNames
cn: otoboallow
member: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: cn=test_sync_group_2,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfNames
cn: test_sync_group_2
member: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
member: cn=waiter_serge,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: cn=test_sync_group_3A,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfUniqueNames
cn: test_sync_group_3A
uniquemember: cn=test_sync_group_3B,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: cn=test_sync_group_3B,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfUniqueNames
cn: test_sync_group_3B
uniquemember: cn=test_sync_group_3C,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: cn=test_sync_group_3C,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfUniqueNames
cn: test_sync_group_3C
uniquemember: cn=test_sync_group_3D,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: cn=test_sync_group_3D,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfUniqueNames
cn: test_sync_group_3D
uniqueMember: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
uniqueMember: cn=waiter_franz,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

dn: ou=café sans souci,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: organizationalUnit
ou: café sans souci

dn: cn=otoboallow,ou=café sans souci,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: groupOfNames
cn: otoboallow
member: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
member: cn=barista_bogdan,ou=café sans souci,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting

# a bavarian speaking waiter, per OTOBO default 'uid' designates the user ID
dn: cn=waiter_karl,ou=dining hall,dc=wirtshaus_[[RANDOM_ID]],dc=otobotesting
changetype: add
objectClass: inetOrgPerson
givenName: Karl
cn: waiter_karl
sn: Kellner
uid: karl
mail: karl@dining_hall.wirtshaus.otobotesting.food
preferredLanguage: bar
userPassword: karl

# a Saterland Frisian speaking waiter, per OTOBO default 'uid' designates the user ID
