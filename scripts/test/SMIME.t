                            },
                            {
                                CertHash        => $WrongHashes{JohanneumCA},
                                CertFingerprint => $Certificates{JohanneumCA}->{Fingerprint},
                                CAHash          => $WrongHashes{CabinetCA},
                                CAFingerprint   => $Certificates{CabinetCA}->{Fingerprint},

