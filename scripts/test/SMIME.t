                    JohanneumCA => {
                        CorrectRelations => [
                            {
                                CertHash        => $Certificates{JohanneumCA}->{Hash},
                                CertFingerprint => $Certificates{JohanneumCA}->{Fingerprint},
                                CAHash          => $Certificates{GeologyCA}->{Hash},
